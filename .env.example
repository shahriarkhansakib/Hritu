# Earthdata Login (earthdata.nasa.gov)
EDL_USER=your_earthdata_username
EDL_PASSWORD=your_earthdata_password

# FIRMS Active Fire API key (firms.modaps.eosdis.nasa.gov/api/map_key/)
FIRMS_MAP_KEY=your_firms_map_key

# NASA API (api.nasa.gov)
NASA_API_KEY=DEMO_KEY

# NASA ADS (ui.adsabs.harvard.edu)
ADS_API_TOKEN=your_ads_token

# Set to 1 to force offline/fixture mode during demo
OFFLINE=0
